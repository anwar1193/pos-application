{
  "name": "pos-application",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo aplikasi POS: web admin (Next.js) dan mobile app (React Native)",
  "workspaces": [
    "web-app",
    "mobile-app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace web-app",
    "build": "npm run build --workspace web-app",
    "start": "npm run start --workspace web-app",
    "lint": "npm run lint --workspace web-app",
    "typecheck": "npm run typecheck --workspace web-app",
    "test": "npm run test --workspace web-app",
    "test:watch": "npm run test:watch --workspace web-app",
    "test:e2e": "npm run test:e2e --workspace web-app",
    "db:generate": "npm run db:generate --workspace web-app",
    "db:migrate": "npm run db:migrate --workspace web-app",
    "db:seed": "npm run db:seed --workspace web-app",
    "db:setup": "npm run db:setup --workspace web-app"
  }
}
