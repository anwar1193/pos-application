# Remote Turso (production). For local development use: file:./local.db
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=
APP_URL=http://localhost:3000

# Seed owner (local/development only)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=change-me-in-development
SEED_ORGANIZATION_NAME=Demo Store
SEED_BRANCH_NAME=Main Branch

# Transactional email (optional). Without these, invitation/reset links are
# surfaced in the UI or API response for development only.
RESEND_API_KEY=
EMAIL_FROM=POS Admin <no-reply@example.com>
EMAIL_DEV_MODE=true
